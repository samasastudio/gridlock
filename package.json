{
  "name": "gridlock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "prebuild": "bash ./scripts/ensure-ext4-deps.sh",
    "build": "node ./node_modules/typescript/bin/tsc -b",
    "pretypecheck": "bash ./scripts/ensure-ext4-deps.sh",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --pretty false",
    "prelint": "bash ./scripts/ensure-ext4-deps.sh",
    "lint": "node ./scripts/lint-checks.mjs",
    "check:pr-size": "node ./scripts/lint-checks.mjs --check-pr-size",
    "pretest": "bash ./scripts/ensure-ext4-deps.sh",
    "test": "node --test packages/core/test/*.test.ts packages/widgets/test/*.test.ts",
    "preverify": "bash ./scripts/ensure-ext4-deps.sh",
    "verify": "node ./scripts/lint-checks.mjs && node --test packages/core/test/*.test.ts packages/widgets/test/*.test.ts"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2"
  }
}
