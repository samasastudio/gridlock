{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rewriteRelativeImportExtensions": false,
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "packages/*/stories/**/*.tsx"
  ],
  "references": [
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/widgets"
    }
  ]
}
